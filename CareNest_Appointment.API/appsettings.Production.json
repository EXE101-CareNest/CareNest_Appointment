    "BaseUrlAddress": "http://localhost:8023",
    "BaseUrlService": "http://localhost:8018",
    "BaseUrlServiceCategory": "http://localhost:8019"
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}


